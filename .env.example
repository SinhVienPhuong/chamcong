# ===== Cấu hình hệ thống chấm công =====
PORT=3000
TZ=Asia/Ho_Chi_Minh

# Thư mục chứa CSDL SQLite (nhớ backup thư mục này)
DATA_DIR=./data

# Mật khẩu admin ban đầu (để trống: tự sinh ngẫu nhiên và in ra console lần chạy đầu)
ADMIN_PASSWORD=

# Khoá ký phiên đăng nhập. Để trống: tự sinh và lưu ở DATA_DIR/.jwt_secret
JWT_SECRET=
SESSION_HOURS=12

# Đặt true khi truy cập qua HTTPS (cookie chỉ gửi qua HTTPS + bật HSTS)
COOKIE_SECURE=false

# Khi chạy sau reverse proxy (Nginx, FortiGate VIP + proxy...) để lấy đúng IP người dùng:
#   loopback = proxy cùng máy, 1 = tin 1 tầng proxy, false = không tin header X-Forwarded-For
TRUST_PROXY=loopback

# Tự động kéo log từ các máy chấm công đã khai báo (phút). 0 = tắt
AUTO_SYNC_MINUTES=0

# Khoá cho agent đẩy log từ chi nhánh (scripts/zk-agent.js). Để trống = tắt endpoint
DEVICE_API_KEY=
